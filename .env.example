# ==========================================
# ZannyPay Backend — environment variables
# Copy this file to .env and fill in the placeholders. Never commit the
# real .env file.
# ==========================================

# ---------- Database (Supabase/Postgres) ----------
# DIRECT_URL: port 5432, no pooling — used by `prisma migrate`/`generate` only.
# DATABASE_URL: port 6543, pgbouncer — used by the running app. connection_limit
# tuned for a single persistent process, not a serverless/edge deployment.
DIRECT_URL="postgresql://user:password@host:5432/zannypay?schema=public"
DATABASE_URL="postgresql://user:password@host:6543/zannypay?schema=public&pgbouncer=true&connection_limit=5"

# ---------- Server ----------
PORT=10000
BACKEND_URL="https://zannypay-backend.onrender.com"

# ---------- Customer auth ----------
JWT_SECRET="replace-with-your-own-long-random-value"

# ---------- Paystack ----------
PAYSTACK_SECRET_KEY="sk_live_or_test_xxx"

# ---------- Outbound email ----------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-password-or-app-password"

# ==========================================
# Admin backend
# ==========================================
ADMIN_JWT_SECRET="v9Dv0UVQ2WHaut13oHWibk-wAS_OOUxLQYLW0GBvXVxV2CyjmzxxVmcn44UHMJuo"
ADMIN_BOOTSTRAP_SECRET="MQYiqPEHdqO_bKqPyFj7aOH2nEXqhFnklK_IHZjHbEE"

# AES-256 key (32 bytes / 64 hex chars) encrypting each admin's TOTP secret.
ADMIN_2FA_ENCRYPTION_KEY="292933fa4558327f57f340f506d2789bc342948cc8105d59d5a933f56faa54b5"

# Same shape, DIFFERENT key, protecting a different domain: encrypts each
# customer's full BVN/NIN before storage (see common/crypto.util.ts). Kept
# separate from ADMIN_2FA_ENCRYPTION_KEY deliberately — these protect very
# different things with very different blast radii, and a leak of one
# should not compromise the other. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_PII_ENCRYPTION_KEY="0d474d8dc2d681054c60a2ded1aea8c0d783d032db4d7fb317fc158325d70ce9"

ADMIN_IP_ALLOWLIST=""
ADMIN_IP_ALLOWLIST_ENFORCE="false"
COMPLIANCE_ALERT_EMAIL=""

# ==========================================
# Object storage — master audit, Critical #2. Replaces base64-in-Postgres
# for profile photos, chat attachments, and KYC documents. See
# storage/storage.service.ts.
# ==========================================
# 's3' (any S3-compatible bucket: AWS S3, Cloudflare R2, DigitalOcean
# Spaces, Backblaze B2), 'local' (dev-only, writes to ./uploads on this
# same process's disk), or leave unset to fall back to storing images
# inline as base64 — fine for a first local run, NOT fine for real users.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Only needed for R2/Spaces/B2 (their S3-compatible endpoint URL) — leave
# unset for real AWS S3.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# If set, this is used to build public URLs instead of deriving one from
# S3_BUCKET/S3_REGION — set this to your CDN domain in front of the bucket.
STORAGE_PUBLIC_BASE_URL=""

# ==========================================
# Card providers — master audit, Section 5. See cards/providers/.
# ==========================================
# Card ISSUING (new ZannyPay-branded cards) has no real-processor option
# wired yet — always mock regardless of this value; left here as a
# placeholder for when a real issuer (Stripe Issuing, Marqeta) is
# integrated.
CARD_ISSUING_PROVIDER="mock"
# Card LINKING (an existing external Visa/Mastercard/Verve card) can use
# Paystack's tokenized-authorization flow — set to "paystack" once the
# mobile client's card-collection handoff is wired up; requires
# PAYSTACK_SECRET_KEY above.
CARD_LINKING_PROVIDER="mock"

# ==========================================
# Compliance — sanctions/PEP screening and KYC liveness. Both currently
# only have a mock adapter (see screening/ and kyc/) — these env vars are
# placeholders for when a real vendor is integrated (ComplyAdvantage/
# Refinitiv for sanctions; Smile Identity/Youverify for liveness), NOT a
# switch that currently does anything.
# ==========================================
SANCTIONS_PROVIDER="mock"
KYC_VERIFICATION_PROVIDER="mock"
